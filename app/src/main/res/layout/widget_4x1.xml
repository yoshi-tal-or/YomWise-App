<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/w_compact" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:paddingLeft="12dp" android:paddingRight="12dp"
        android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
